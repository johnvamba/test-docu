APP_NAME="Ajaia Docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Match `id -u` / `id -g` on Linux so bind-mounted files stay owned by you
UID=1000
GID=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ajaia
DB_USERNAME=ajaia
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local-only Reverb credentials. Generate fresh values for any deployed environment.
REVERB_APP_ID=100001
REVERB_APP_KEY=ajaia-local-key
REVERB_APP_SECRET=ajaia-local-secret

# Server side: Laravel publishes events to the Reverb container directly
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Browser side: Echo connects through nginx on the app port.
# Served to the page at runtime (config/services.php "realtime"), not baked into the JS build.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8000
REVERB_PUBLIC_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
